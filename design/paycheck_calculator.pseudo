# INPUT, LET, IF, ELSE, and OUTPUT where they fit your design.

BEGIN paycheck_calculator

    INPUT hours_worked

    IF hours_worked > 40 THEN
        SET overtime_hours = hours_worked - 40
        SET regular_pay = 40 * 20
        SET overtime_pay = overtime_hours * 30
        SET total_pay = regular_pay + overtime_pay
     ELSE
        SET total_pay = hours_worked * 20
    ENDIF

    OUTPUT total_pay   

END paycheck_calculator

